+// SPDX-License-Identifier: MPL-2.0
+
+//! Raw virtio serial ports, independent of the console's terminal processing.
+
+use aster_virtio::device::console::{device, port::ConsolePort};
+use device_id::{DeviceId, MinorId};
+
+use crate::{
+    device::{Device, DeviceType, registry::char},
+    events::IoEvents,
+    fs::{
+        devtmpfs::DevtmpfsNodeMeta,
+        file::{PerOpenFileOps, StatusFlags},
+        vfs::{inode::FileOps, path::Path},
+    },
+    prelude::*,
+    process::signal::{PollHandle, Pollable, Pollee},
+    util::ioctl::{OutData, RawIoctl},
+};
+
+// Bootstrap discovery until virtio-ports sysfs/udev integration is available.
+// Private PoC ABI: _IOR('V', 0, char[128]), a NUL-terminated port name.
+type GetPortName = crate::ioc!(VPORT_GET_NAME, b'V', 0, OutData<[u8; 128]>);
+
+struct PortState {
+    port: Arc<ConsolePort>,
+    pollee: Pollee,
+}
+
+struct PortDevice {
+    id: DeviceId,
+    state: Arc<PortState>,
+    _major: Arc<char::MajorIdOwner>,
+}
+
+impl Device for PortDevice {
+    fn type_(&self) -> DeviceType {
+        DeviceType::Char
+    }
+    fn id(&self) -> DeviceId {
+        self.id
+    }
+    fn devtmpfs_meta(&self) -> Option<DevtmpfsNodeMeta> {
+        Some(
+            DevtmpfsNodeMeta::new(alloc::format!(
+                "vport{}p{}",
+                self.state.port.device_index(),
+                self.state.port.id()
+            ))
+            .unwrap(),
+        )
+    }
+    fn open(&self) -> Result<Box<dyn PerOpenFileOps>> {
+        Ok(Box::new(PortFile {
+            state: self.state.clone(),
+        }))
+    }
+}
+
+struct PortFile {
+    state: Arc<PortState>,
+}
+
+impl Pollable for PortFile {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.state.pollee.poll_with(mask, poller, || {
+            let mut events = IoEvents::empty();
+            if self.state.port.can_read() {
+                events |= IoEvents::IN;
+            }
+            if self.state.port.can_write() {
+                events |= IoEvents::OUT;
+            }
+            if self.state.port.info().host_open == Some(false) {
+                events |= IoEvents::IN | IoEvents::HUP;
+            }
+            events
+        })
+    }
+}
+
+impl FileOps for PortFile {
+    fn read_at(&self, _offset: usize, writer: &mut VmWriter, flags: StatusFlags) -> Result<usize> {
+        if writer.avail() == 0 {
+            return Ok(0);
+        }
+        let mut bytes = vec![0; writer.avail().min(PAGE_SIZE)];
+        let mut read = || {
+            self.state
+                .port
+                .try_read(&mut bytes)
+                .ok_or_else(|| Error::with_message(Errno::EAGAIN, "no port data is available"))
+        };
+        let count = if flags.contains(StatusFlags::O_NONBLOCK) {
+            read()?
+        } else {
+            self.wait_events(IoEvents::IN, None, read)?
+        };
+        self.state.pollee.invalidate();
+        writer.write_fallible(&mut bytes[..count].into())?;
+        Ok(count)
+    }
+
+    fn write_at(&self, _offset: usize, reader: &mut VmReader, flags: StatusFlags) -> Result<usize> {
+        if reader.remain() == 0 {
+            return Ok(0);
+        }
+        let mut bytes = vec![0; reader.remain().min(ConsolePort::MAX_WRITE_SIZE)];
+        let len = reader.read_fallible(&mut bytes.as_mut_slice().into())?;
+        let write = || {
+            if self.state.port.info().host_open == Some(false) {
+                return_errno_with_message!(Errno::EPIPE, "the host port is closed");
+            }
+            self.state
+                .port
+                .try_write(&bytes[..len])
+                .ok_or_else(|| Error::with_message(Errno::EAGAIN, "the port output queue is full"))
+        };
+        let count = if flags.contains(StatusFlags::O_NONBLOCK) {
+            write()?
+        } else {
+            self.wait_events(IoEvents::OUT, None, write)?
+        };
+        self.state.pollee.invalidate();
+        Ok(count)
+    }
+}
+
+impl PerOpenFileOps for PortFile {
+    fn check_seekable(&self) -> Result<()> {
+        return_errno_with_message!(Errno::ESPIPE, "the port is not seekable");
+    }
+    fn is_offset_aware(&self) -> bool {
+        false
+    }
+    fn ioctl(&self, _path: &Path, raw_ioctl: RawIoctl) -> Result<i32> {
+        crate::dispatch_ioctl!(match raw_ioctl {
+            cmd @ GetPortName => {
+                let info = self.state.port.info();
+                if info.is_console {
+                    return_errno_with_message!(Errno::ENODATA, "the port is a console");
+                }
+                if !info.present || info.name.is_empty() {
+                    return_errno_with_message!(Errno::EAGAIN, "the port name is not available");
+                }
+                let mut name = [0; 128];
+                name[..info.name.len()].copy_from_slice(info.name.as_bytes());
+                cmd.write(&name)?;
+            }
+            _ => return_errno_with_message!(Errno::ENOTTY, "the port ioctl is not supported"),
+        });
+        Ok(0)
+    }
+}
+
+pub(super) fn init_in_first_process() -> Result<()> {
+    let ports = device::ports();
+    if ports.is_empty() {
+        return Ok(());
+    }
+    // The registry and open files hold the devices for the kernel's lifetime.
+    let major = Arc::new(char::allocate_major()?);
+    for (index, port) in ports.into_iter().enumerate() {
+        let state = Arc::new(PortState {
+            port,
+            pollee: Pollee::new(),
+        });
+        let weak = Arc::downgrade(&state);
+        state.port.register_notifier(Arc::new(move || {
+            if let Some(state) = weak.upgrade() {
+                state
+                    .pollee
+                    .notify(IoEvents::IN | IoEvents::OUT | IoEvents::HUP);
+            }
+        }));
+        char::register(Arc::new(PortDevice {
+            id: DeviceId::new(major.get(), MinorId::new(index as u32)),
+            state,
+            _major: major.clone(),
+        }))?;
+    }
+    Ok(())
+}
