+// SPDX-License-Identifier: MPL-2.0
+
+//! Bounded, asynchronous control queues for virtio console port discovery.
+//!
+//! Wire format: Virtio 1.2, section 5.3.6.2.
+
+use alloc::{collections::VecDeque, vec::Vec};
+
+use aster_util::mem_obj_slice::Slice;
+use ostd::mm::{PAGE_SIZE, dma::DmaStream, io::util::HasVmReaderWriter};
+
+use crate::{device::VirtioDeviceError, queue::VirtQueue, transport::VirtioTransport};
+
+const RECEIVE_SLOTS: usize = 32;
+const CONTROL_BUFFER_SIZE: usize = 256;
+
+pub(super) mod event {
+    pub(crate) const DEVICE_READY: u16 = 0;
+    pub(crate) const PORT_ADD: u16 = 1;
+    pub(crate) const PORT_REMOVE: u16 = 2;
+    pub(crate) const PORT_READY: u16 = 3;
+    pub(crate) const CONSOLE_PORT: u16 = 4;
+    pub(crate) const RESIZE: u16 = 5;
+    pub(crate) const PORT_OPEN: u16 = 6;
+    pub(crate) const PORT_NAME: u16 = 7;
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Pod)]
+pub(super) struct ControlMessage {
+    pub(super) id: u32,
+    pub(super) event: u16,
+    pub(super) value: u16,
+}
+
+impl ControlMessage {
+    pub(super) fn new(id: u32, event: u16, value: u16) -> Self {
+        Self {
+            id: id.to_le(),
+            event: event.to_le(),
+            value: value.to_le(),
+        }
+    }
+}
+
+pub(super) struct ControlQueues {
+    receive: VirtQueue,
+    transmit: VirtQueue,
+    receive_buffer: DmaStream,
+    receive_slots: [usize; RECEIVE_SLOTS],
+    transmit_buffer: DmaStream,
+    pending: VecDeque<ControlMessage>,
+    in_flight: bool,
+}
+
+impl ControlQueues {
+    pub(super) fn new(transport: &mut dyn VirtioTransport) -> Result<Self, VirtioDeviceError> {
+        let receive = VirtQueue::new(2, RECEIVE_SLOTS as u16, transport)?;
+        let transmit = VirtQueue::new(3, 2, transport)?;
+        let receive_buffer = DmaStream::alloc(
+            (RECEIVE_SLOTS * CONTROL_BUFFER_SIZE).div_ceil(PAGE_SIZE),
+            false,
+        )
+        .map_err(VirtioDeviceError::ResourceAlloc)?;
+        let transmit_buffer =
+            DmaStream::alloc(1, false).map_err(VirtioDeviceError::ResourceAlloc)?;
+        let mut queues = Self {
+            receive,
+            transmit,
+            receive_buffer,
+            receive_slots: [0; RECEIVE_SLOTS],
+            transmit_buffer,
+            pending: VecDeque::new(),
+            in_flight: false,
+        };
+        // Keep the control receive queue populated: libkrun coalesces control
+        // notifications and does not pump pending messages on receive kicks.
+        for slot in 0..RECEIVE_SLOTS {
+            queues.post_receive(slot);
+        }
+        queues.receive.notify();
+        Ok(queues)
+    }
+
+    pub(super) fn send(&mut self, message: ControlMessage) {
+        // At most 32 ports are supported. Keep malformed host event floods bounded.
+        if self.pending.len() < 128 {
+            self.pending.push_back(message);
+        }
+        self.flush();
+    }
+
+    pub(super) fn flush(&mut self) {
+        while self.transmit.pop_used_for_input().is_ok() {
+            self.in_flight = false;
+        }
+        if self.in_flight {
+            return;
+        }
+        let Some(message) = self.pending.pop_front() else {
+            return;
+        };
+        self.transmit_buffer
+            .writer()
+            .unwrap()
+            .write_val(&message)
+            .unwrap();
+        self.transmit_buffer
+            .sync_to_device(0..size_of::<ControlMessage>())
+            .unwrap();
+        self.transmit
+            .add_input_bufs(&[&Slice::new(
+                &self.transmit_buffer,
+                0..size_of::<ControlMessage>(),
+            )])
+            .unwrap();
+        self.in_flight = true;
+        self.transmit.notify();
+    }
+
+    pub(super) fn receive(&mut self) -> Vec<(ControlMessage, Vec<u8>)> {
+        let mut messages = Vec::new();
+        let mut replenished = false;
+        while let Ok((token, len)) = self.receive.pop_used() {
+            replenished = true;
+            let slot = self.receive_slots[token as usize];
+            let offset = slot * CONTROL_BUFFER_SIZE;
+            let len = (len as usize).min(CONTROL_BUFFER_SIZE);
+            self.receive_buffer
+                .sync_from_device(offset..offset + len)
+                .unwrap();
+            if len >= size_of::<ControlMessage>() {
+                let mut reader = self.receive_buffer.reader().unwrap();
+                reader.skip(offset);
+                reader.limit(len);
+                let mut message: ControlMessage = reader.read_val().unwrap();
+                message.id = u32::from_le(message.id);
+                message.event = u16::from_le(message.event);
+                message.value = u16::from_le(message.value);
+                let mut payload = alloc::vec![0; reader.remain()];
+                reader.read(&mut payload.as_mut_slice().into());
+                messages.push((message, payload));
+            }
+            self.post_receive(slot);
+        }
+        if replenished {
+            self.receive.notify();
+        }
+        messages
+    }
+
+    fn post_receive(&mut self, slot: usize) {
+        let offset = slot * CONTROL_BUFFER_SIZE;
+        let token = self
+            .receive
+            .add_output_bufs(&[&Slice::new(
+                &self.receive_buffer,
+                offset..offset + CONTROL_BUFFER_SIZE,
+            )])
+            .unwrap();
+        self.receive_slots[token as usize] = slot;
+    }
+}
