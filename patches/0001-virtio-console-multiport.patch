+// SPDX-License-Identifier: MPL-2.0
+
+//! Independent console ports with bounded receive and transmit buffers.
+
+use alloc::{
+    boxed::Box,
+    collections::VecDeque,
+    fmt,
+    string::{String, ToString},
+    sync::Arc,
+    vec::Vec,
+};
+
+use aster_console::{AnyConsoleDevice, ConsoleCallback};
+use aster_util::mem_obj_slice::Slice;
+use ostd::{
+    mm::{PAGE_SIZE, VmReader, dma::DmaStream, io::util::HasVmReaderWriter},
+    sync::{LocalIrqDisabled, Rcu, SpinLock},
+};
+
+use crate::{device::VirtioDeviceError, queue::VirtQueue, transport::VirtioTransport};
+
+const TX_SLOTS: usize = 16;
+const TX_CHUNK: usize = PAGE_SIZE / TX_SLOTS;
+
+pub type PortCallback = dyn Fn() + Send + Sync;
+
+#[derive(Clone, Debug, Default)]
+pub struct PortInfo {
+    pub name: String,
+    pub present: bool,
+    pub is_console: bool,
+    pub host_open: Option<bool>,
+    pub guest_open: bool,
+    pub cols: u16,
+    pub rows: u16,
+}
+
+pub struct ConsolePort {
+    device_index: usize,
+    id: u32,
+    info: SpinLock<PortInfo, LocalIrqDisabled>,
+    receive: SpinLock<ReceiveQueue, LocalIrqDisabled>,
+    transmit: SpinLock<TransmitQueue, LocalIrqDisabled>,
+    callbacks: Rcu<Box<Vec<Arc<PortCallback>>>>,
+    legacy_callbacks: Rcu<Box<Vec<&'static ConsoleCallback>>>,
+}
+
+struct ReceiveQueue {
+    queue: VirtQueue,
+    buffer: DmaStream,
+    ready: core::ops::Range<usize>,
+    posted: bool,
+    capacity: usize,
+}
+
+struct TransmitQueue {
+    queue: VirtQueue,
+    buffer: DmaStream,
+    free: VecDeque<usize>,
+    in_flight: [Option<usize>; TX_SLOTS],
+}
+
+impl ConsolePort {
+    pub const MAX_WRITE_SIZE: usize = TX_CHUNK;
+
+    pub(super) fn new(
+        device_index: usize,
+        id: u32,
+        multiport: bool,
+        transport: &mut dyn VirtioTransport,
+    ) -> Result<Self, VirtioDeviceError> {
+        let receive_index = if id == 0 { 0 } else { 2 + 2 * id as u16 };
+        let receive = ReceiveQueue {
+            queue: VirtQueue::new(receive_index, 2, transport)?,
+            buffer: DmaStream::alloc(1, false).map_err(VirtioDeviceError::ResourceAlloc)?,
+            ready: 0..0,
+            posted: false,
+            // Retain the upstream QEMU console workaround; raw ports use full pages.
+            capacity: if id == 0 { 1 } else { PAGE_SIZE },
+        };
+        let transmit = TransmitQueue {
+            queue: VirtQueue::new(receive_index + 1, TX_SLOTS as u16, transport)?,
+            buffer: DmaStream::alloc(1, false).map_err(VirtioDeviceError::ResourceAlloc)?,
+            free: (0..TX_SLOTS).collect(),
+            in_flight: [None; TX_SLOTS],
+        };
+        let info = PortInfo {
+            present: !multiport,
+            is_console: !multiport,
+            host_open: if multiport { None } else { Some(true) },
+            guest_open: !multiport,
+            ..PortInfo::default()
+        };
+        Ok(Self {
+            device_index,
+            id,
+            info: SpinLock::new(info),
+            receive: SpinLock::new(receive),
+            transmit: SpinLock::new(transmit),
+            callbacks: Rcu::new(Box::new(Vec::new())),
+            legacy_callbacks: Rcu::new(Box::new(Vec::new())),
+        })
+    }
+
+    pub fn device_index(&self) -> usize {
+        self.device_index
+    }
+    pub fn id(&self) -> u32 {
+        self.id
+    }
+    pub fn info(&self) -> PortInfo {
+        self.info.lock().clone()
+    }
+    pub(super) fn receive_index(&self) -> u16 {
+        if self.id == 0 {
+            0
+        } else {
+            2 + 2 * self.id as u16
+        }
+    }
+    pub(super) fn transmit_index(&self) -> u16 {
+        self.receive_index() + 1
+    }
+
+    pub fn register_notifier(&self, callback: Arc<PortCallback>) {
+        loop {
+            let current = self.callbacks.read();
+            let mut next = current.get().clone();
+            next.push(callback.clone());
+            if current.compare_exchange(next).is_ok() {
+                break;
+            }
+        }
+    }
+
+    pub fn notify(&self) {
+        let callbacks = self.callbacks.read();
+        for callback in callbacks.get().iter() {
+            callback();
+        }
+        let legacy = self.legacy_callbacks.read();
+        if !legacy.get().is_empty() {
+            let mut bytes = [0u8; 1];
+            while self.try_read(&mut bytes) == Some(1) {
+                for callback in legacy.get().iter() {
+                    callback(VmReader::from(bytes.as_slice()));
+                }
+            }
+        }
+    }
+
+    pub fn can_read(&self) -> bool {
+        self.receive.lock().has_data()
+    }
+
+    /// Attempts a raw read; an empty successful read means host EOF.
+    pub fn try_read(&self, output: &mut [u8]) -> Option<usize> {
