+fn create_standard_dev_links(path_resolver: &PathResolver) -> Result<()> {
+    // A minimal rootfs init may not supply these aliases itself. Populate the
+    // mounted devtmpfs before starting it, without an initramfs setup program.
+    let dev = path_resolver.lookup(&FsPath::try_from("/dev")?)?;
+    for (name, target) in [
+        ("fd", "/proc/self/fd"),
+        ("stdin", "/proc/self/fd/0"),
+        ("stdout", "/proc/self/fd/1"),
+        ("stderr", "/proc/self/fd/2"),
+    ] {
+        match dev.new_symlink_child(name, target, mkmod!(a+rwx)) {
+            Ok(_) => {}
+            Err(error) if error.error() == Errno::EEXIST => {}
+            Err(error) => return Err(error),
+        }
+    }
+    Ok(())
+}
