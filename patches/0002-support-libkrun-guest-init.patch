+// SPDX-License-Identifier: MPL-2.0
+
+//! Restricted scalar `FUSE_IOCTL` requests without input/output payloads.
+//!
+//! Reference: Linux UAPI `include/uapi/linux/fuse.h`, `fuse_ioctl_in/out`.
+
+use ostd::mm::{Infallible, VmReader, VmWriter};
+
+use crate::{FuseError, FuseFileHandle, FuseOpcode, FuseOperation, FuseResult, ReplyExpectation};
+
+/// The target inode is a directory (`FUSE_IOCTL_DIR`).
+pub const IOCTL_DIRECTORY: u32 = 1 << 4;
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Pod)]
+struct IoctlReq {
+    fh: FuseFileHandle,
+    flags: u32,
+    cmd: u32,
+    arg: u64,
+    in_size: u32,
+    out_size: u32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Pod)]
+struct IoctlReply {
+    result: i32,
+    flags: u32,
+    in_iovs: u32,
+    out_iovs: u32,
+}
+
+/// An ioctl with an immediate argument and no copied payload or retry vectors.
+pub struct ScalarIoctlOperation {
+    request: IoctlReq,
+}
+
+impl ScalarIoctlOperation {
+    pub const fn new(fh: FuseFileHandle, flags: u32, cmd: u32, arg: u64) -> Self {
+        Self {
+            request: IoctlReq {
+                fh,
+                flags,
+                cmd,
+                arg,
+                in_size: 0,
+                out_size: 0,
+            },
+        }
+    }
+}
+
+impl FuseOperation for ScalarIoctlOperation {
+    type Output = i32;
+
+    fn opcode(&self) -> FuseOpcode {
+        FuseOpcode::Ioctl
+    }
+    fn body_len(&self) -> usize {
+        size_of::<IoctlReq>()
+    }
+    fn write_body(&mut self, writer: &mut VmWriter<'_, Infallible>) -> FuseResult<()> {
+        writer
+            .write_val(&self.request)
+            .map_err(|_| FuseError::BufferTooSmall)
+    }
+    fn reply_expectation(&self) -> ReplyExpectation {
+        ReplyExpectation::payload(size_of::<IoctlReply>())
+    }
+    fn parse_reply(payload_len: usize, reader: &mut VmReader<'_, Infallible>) -> FuseResult<i32> {
+        if payload_len != size_of::<IoctlReply>() {
+            return Err(FuseError::MalformedResponse);
+        }
+        let reply: IoctlReply = reader
+            .read_val()
+            .map_err(|_| FuseError::MalformedResponse)?;
+        // Never accept unrestricted retries or host-provided user-memory vectors.
+        if reply.flags != 0 || reply.in_iovs != 0 || reply.out_iovs != 0 {
+            return Err(FuseError::MalformedResponse);
+        }
+        if reply.result < 0 {
+            return Err(FuseError::RemoteError(reply.result));
+        }
+        Ok(reply.result)
+    }
+}
