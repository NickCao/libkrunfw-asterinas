+// SPDX-License-Identifier: MPL-2.0
+
+//! Legacy Intel MP tables for BIOS-compatible machines without an ACPI MADT.
+//!
+//! Discovery and validation run before the heap and frame allocators exist. The
+//! parsed view borrows firmware memory, which the boot code reserves before
+//! enabling the frame allocator. Explicit MP 1.1/1.4 base tables in conventional
+//! memory or BIOS ROM are supported; implicit default configurations are not.
+//! Reference: <https://pdos.csail.mit.edu/6.828/2018/readings/ia32/MPspec.pdf>.
+
+use spin::Once;
+
+use crate::mm::paddr_to_vaddr;
+
+static TABLES: Once<Option<MpTables>> = Once::new();
+
+pub(in crate::arch) struct MpTables {
+    floating_address: usize,
+    config_address: usize,
+    config_len: usize,
+    entries: &'static [u8],
+    processor_count: u32,
+    isa_buses: [u64; 4],
+    imcr_present: bool,
+}
+
+pub(in crate::arch) struct IoApicInfo {
+    pub id: u8,
+    pub address: usize,
+}
+
+pub(in crate::arch) struct IsaInterrupt {
+    pub source: u8,
+    pub io_apic_id: u8,
+    pub input: u8,
+}
+
+impl MpTables {
+    pub(in crate::arch) fn processor_count(&self) -> u32 {
+        self.processor_count
+    }
+
+    pub(in crate::arch) fn imcr_present(&self) -> bool {
+        self.imcr_present
+    }
+
+    pub(in crate::arch) fn reserved_regions(&self) -> [(usize, usize); 2] {
+        [
+            (self.floating_address, 16),
+            (self.config_address, self.config_len),
+        ]
+    }
+
+    fn entries(&self) -> impl Iterator<Item = &[u8]> {
+        entries(self.entries)
+    }
+
+    pub(in crate::arch) fn io_apics(&self) -> impl Iterator<Item = IoApicInfo> {
+        self.entries().filter_map(|entry| {
+            (entry[0] == 2 && entry[3] & 1 != 0).then(|| IoApicInfo {
+                id: entry[1],
+                address: u32_at(entry, 4).unwrap() as usize,
+            })
+        })
+    }
+
+    pub(in crate::arch) fn isa_interrupts(&self) -> impl Iterator<Item = IsaInterrupt> {
+        self.entries().filter_map(|entry| {
+            if entry[0] != 3 || entry[1] != 0 || !contains(&self.isa_buses, entry[4]) {
+                return None;
+            }
+            Some(IsaInterrupt {
+                source: entry[5],
+                io_apic_id: entry[6],
+                input: entry[7],
+            })
+        })
+    }
+}
+
+pub(in crate::arch) fn get() -> Option<&'static MpTables> {
+    TABLES.get().and_then(Option::as_ref)
+}
+
+/// Discovers explicit MP tables in legacy BIOS memory without allocating.
+///
+/// # Safety
+///
+/// The caller must be on the BSP before the frame allocator starts. The BIOS
+/// data area, conventional memory, and BIOS ROM below 1 MiB must be readable
+/// through the physical direct map and immutable until their reservations are
+/// installed. This function must only be used on a BIOS-compatible boot path.
+pub(in crate::arch) unsafe fn init() {
+    TABLES.call_once(|| {
+        // SAFETY: The caller guarantees access to legacy BIOS memory.
+        unsafe { find_tables() }
+    });
+}
+
+// All physical reads are confined to conventional memory and system BIOS ROM.
+fn valid_range(address: usize, len: usize) -> bool {
+    let Some(end) = address.checked_add(len) else {
+        return false;
+    };
+    address != 0 && (end <= 0xa0000 || (address >= 0xf0000 && end <= 0x100000))
+}
+
+/// # Safety
+/// The caller must uphold the legacy BIOS memory contract documented by `init`.
+unsafe fn bios_bytes(address: usize, len: usize) -> Option<&'static [u8]> {
+    if !valid_range(address, len) {
+        return None;
+    }
+    // SAFETY: The range is within the legacy memory the caller guarantees is
+    // mapped and readable. Accepted table regions are reserved before any frame
+    // allocations can overwrite them, preserving the returned immutable slice.
+    Some(unsafe { core::slice::from_raw_parts(paddr_to_vaddr(address) as *const u8, len) })
+}
+
+/// # Safety
+/// The caller must uphold the legacy BIOS memory contract documented by `init`.
+unsafe fn find_tables() -> Option<MpTables> {
+    // The MP specification searches the first KiB of EBDA, the final KiB of
+    // conventional RAM, and the system BIOS ROM, in that order.
+    // SAFETY: These two BIOS data-area fields are covered by the caller's contract.
+    let ebda = u16_at(unsafe { bios_bytes(0x40e, 2)? }, 0)? as usize * 16;
+    // SAFETY: As above, for the conventional-memory size field.
+    let ram_end = u16_at(unsafe { bios_bytes(0x413, 2)? }, 0)? as usize * 1024;
+    // Direct-boot VMMs may omit BIOS data-area fields while placing the MP
+    // pointer in the final KiB of the standard 640-KiB conventional-memory area.
+    let ram_end = if (0x10000..=0xa0000).contains(&ram_end) {
+        ram_end
+    } else {
+        0xa0000
+    };
+    for (start, len) in [
+        (ebda, 1024),
+        (ram_end.saturating_sub(1024), 1024),
+        (0xf0000, 0x10000),
+    ] {
+        if start & 15 != 0 || !valid_range(start, len) {
+            continue;
+        }
+        for address in (start..start + len).step_by(16) {
+            // SAFETY: Discovery reads only checked legacy BIOS ranges.
+            if let Some(tables) = unsafe { tables_at(address) } {
+                return Some(tables);
+            }
+        }
+    }
+    None
+}
+
+/// # Safety
+/// The caller must uphold the legacy BIOS memory contract documented by `init`.
+unsafe fn tables_at(address: usize) -> Option<MpTables> {
+    // SAFETY: `bios_bytes` validates the range within the caller's BIOS mapping.
+    let floating = unsafe { bios_bytes(address, 16)? };
+    if &floating[..4] != b"_MP_"
+        || floating[8] != 1
+        || !matches!(floating[9], 1 | 4)
+        || !checksum_valid(floating)
+        || floating[11] != 0
+    {
+        return None;
+    }
+    let config_address = u32_at(floating, 4)? as usize;
+    // SAFETY: The physical range is checked before the firmware header is read.
+    let header = unsafe { bios_bytes(config_address, 44)? };
+    if &header[..4] != b"PCMP" || !matches!(header[6], 1 | 4) {
+        return None;
+    }
+    let base_len = u16_at(header, 4)? as usize;
+    let extended_len = u16_at(header, 40)? as usize;
+    if base_len < 44 {
+        return None;
+    }
+    let config_len = base_len.checked_add(extended_len)?;
+    // SAFETY: Both table lengths are bounded by `bios_bytes`, including their sum.
+    let config = unsafe { bios_bytes(config_address, config_len)? };
+    if !checksum_valid(&config[..base_len])
+        || (extended_len != 0 && byte_sum(&config[base_len..]).wrapping_add(header[42]) != 0)
+    {
+        return None;
+    }
+    let local_apic_address = u32_at(header, 36)?;
+    if local_apic_address == 0 || local_apic_address & 0xfff != 0 {
+        return None;
+    }
+    let table_entries = &config[44..base_len];
+    let mut processor_count = 0;
+    let mut bootstrap_processors = 0;
+    let mut processor_ids = [0u64; 4];
+    let mut io_apic_ids = [0u64; 4];
+    let mut isa_buses = [0u64; 4];
+    let mut entry_count = 0;
+    let mut parsed_len = 0;
+    for entry in entries(table_entries) {
+        entry_count += 1;
+        parsed_len += entry.len();
+        match entry[0] {
+            0 if entry[3] & 1 != 0 => {
+                if entry[1] == 255 || !insert(&mut processor_ids, entry[1]) {
+                    return None;
+                }
+                processor_count += 1;
+                bootstrap_processors += u32::from(entry[3] & 2 != 0);
+            }
+            1 if &entry[2..8] == b"ISA   " => {
+                insert(&mut isa_buses, entry[1]);
+            }
+            2 if entry[3] & 1 != 0 => {
+                let io_apic_address = u32_at(entry, 4)?;
+                if entry[1] == 255
+                    || !insert(&mut io_apic_ids, entry[1])
+                    || io_apic_address == 0
+                    || io_apic_address & 0xfff != 0
+                {
+                    return None;
+                }
+            }
+            _ => {}
+        }
+    }
+    // Some Linux-compatible VMMs leave the entry-count field zero. Like Linux,
+    // walk complete entries up to the validated base-table length in that case.
+    let declared_count = u16_at(header, 34)?;
+    if parsed_len != table_entries.len()
+        || (declared_count != 0 && entry_count != declared_count)
+        || processor_count == 0
+        || bootstrap_processors != 1
+    {
+        return None;
+    }
+    Some(MpTables {
+        floating_address: address,
+        config_address,
+        config_len,
+        entries: table_entries,
+        processor_count,
+        isa_buses,
+        imcr_present: floating[12] & 0x80 != 0,
+    })
+}
+
+fn entries(bytes: &[u8]) -> impl Iterator<Item = &[u8]> {
+    let mut position = 0;
+    core::iter::from_fn(move || {
+        let len = match *bytes.get(position)? {
+            0 => 20,
+            1..=4 => 8,
+            _ => return None,
+        };
+        let entry = bytes.get(position..position + len)?;
+        position += len;
+        Some(entry)
+    })
+}
+
+fn u16_at(bytes: &[u8], offset: usize) -> Option<u16> {
+    Some(u16::from_le_bytes(
+        bytes.get(offset..offset + 2)?.try_into().ok()?,
+    ))
+}
+
+fn u32_at(bytes: &[u8], offset: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(
+        bytes.get(offset..offset + 4)?.try_into().ok()?,
+    ))
+}
+
+fn checksum_valid(bytes: &[u8]) -> bool {
+    byte_sum(bytes) == 0
+}
+
+fn byte_sum(bytes: &[u8]) -> u8 {
+    bytes.iter().fold(0u8, |sum, byte| sum.wrapping_add(*byte))
+}
+
+fn contains(set: &[u64; 4], id: u8) -> bool {
+    set[id as usize / 64] & (1u64 << (id % 64)) != 0
+}
+
+fn insert(set: &mut [u64; 4], id: u8) -> bool {
+    let present = contains(set, id);
+    set[id as usize / 64] |= 1u64 << (id % 64);
+    !present
+}
